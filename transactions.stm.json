ion":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"C7Sw5EgO8m"}],"key":"MGkdHxkj0v"},{"type":"code","lang":"julia","value":"using AirDB, Air\n\nwidget = VolatileForm(db, \"widget\", n = 1)\n\n@tx widget[:n] = 42       # stage the change ...\n# ... it commits here, and the writer is told to save the new form\nvalue(widget[:n])          # 42","position":{"start":{"line":19,"column":1},"end":{"line":27,"column":1}},"key":"VO1juqPqT3"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Outside a transaction a write is an error, inherited from Air:","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"ZnTZBREkrc"}],"key":"PXjUGnk4vz"},{"type":"code","lang":"julia","value":"widget[:n] = 5\n# ERROR: cannot set volatile outside of transaction","position":{"start":{"line":31,"column":1},"end":{"line":34,"column":1}},"key":"xt4OXmzwV7"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"OtxOyZgUTn"},{"type":"inlineCode","value":"tx","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"pYDKp2TJ6E"},{"type":"text","value":" function is the non-macro form, handy when you already have a closure:","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"H3B0lbn4Dp"}],"key":"ZqfI9K9EbG"},{"type":"code","lang":"julia","value":"tx(() -> (widget[:n] = value(widget[:n]) + 1))","position":{"start":{"line":38,"column":1},"end":{"line":40,"column":1}},"key":"Qbw2IWNdk8"},{"type":"heading","depth":2,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"A commit is atomic","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"P1eSTPCtr6"}],"identifier":"a-commit-is-atomic","label":"A commit is atomic","html_id":"a-commit-is-atomic","implicit":true,"key":"MKKsVEuJ0s"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"All the writes in one transaction become visible together, and all the sends are\ndispatched together, in commit order. A commit that changes several forms writes\nthem to the database in a single database transaction, so a reader never sees\nhalf of a commit.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"fpTzTg0PoD"}],"key":"IPOsVb6jJx"},{"type":"code","lang":"julia","value":"a = VolatileForm(db, kind = \"A\")\nb = VolatileForm(db, kind = \"B\")\n\n@tx begin\n    a[:v] = 1\n    b[:v] = 2\nend\nAirDB.sync(db)\n(value(a[:v]), value(b[:v]))   # (1, 2) — both landed together","position":{"start":{"line":49,"column":1},"end":{"line":59,"column":1}},"key":"zCVO2AMlnq"},{"type":"heading","depth":2,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"The body may run more than once","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"uZ7cbOSaq3"}],"identifier":"the-body-may-run-more-than-once","label":"The body may run more than once","html_id":"the-body-may-run-more-than-once","implicit":true,"key":"uMGJFJ34xI"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Air is optimistic: a transaction records what it reads, and if any of those\nvalues change before it commits, the transaction is discarded and re-run. So the\nbody of a transaction must be free of side effects other than the transactional\nones.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"fITjQMh9FW"}],"key":"jFq8P6DNbe"},{"type":"code","lang":"julia","value":"# Good: the only side effect is the transactional write.\n@tx widget[:n] = value(widget[:n]) + 1\n\n# Bad: this prints a different number of times depending on contention.\n@tx begin\n    println(\"attempt\")          # do not do this\n    widget[:n] = value(widget[:n]) + 1\nend","position":{"start":{"line":68,"column":1},"end":{"line":77,"column":1}},"key":"abQyxamfRV"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"If the body throws, nothing is written:","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"KuU3ACN7vo"}],"key":"orOnk9Kpi3"},{"type":"code","lang":"julia","value":"try\n    @tx begin\n        widget[:n] = 99\n        error(\"abort\")\n    end\ncatch\nend\nvalue(widget[:n])                 # still 42 — the write never happened","position":{"start":{"line":81,"column":1},"end":{"line":90,"column":1}},"key":"s7P3xJPkNl"},{"type":"heading","depth":2,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Reading inside a transaction","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"izTD8TWLQZ"}],"identifier":"reading-inside-a-transaction","label":"Reading inside a transaction","html_id":"reading-inside-a-transaction","implicit":true,"key":"jFQEXyTGDd"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Reading a form inside a transaction registers an Air read, so the transaction\nsees a consistent value and will be re-run if it changes. A form that has not\nyet been loaded from the database is loaded on first access; that is ordinary\nlazy loading (see\n","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"GQfjYd7OFf"},{"type":"link","url":"/transactions/lazy-loading-and-cache","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"Lazy loading and the cache","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"xgcc1RGyZ8"}],"urlSource":"lazy-loading-and-cache.md","dataUrl":"/transactions.lazy-loading-and-cache.json","internal":true,"protocol":"file","key":"xjjyMc8Mzc"},{"type":"text","value":"), and it is safe inside\na transaction.","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"uLx4puZ0Bk"}],"key":"lCR1E7lUBo"},{"type":"code","lang":"julia","value":"@tx begin\n    current = value(widget[:n])   # read (and register)\n    widget[:n] = current + 1      # write\nend","position":{"start":{"line":101,"column":1},"end":{"line":106,"column":1}},"key":"QeYE1VXI1l"},{"type":"heading","depth":2,"position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"Read-your-writes and durability","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"KzQ9tQ9PgT"}],"identifier":"read-your-writes-and-durability","label":"Read-your-writes and durability","html_id":"read-your-writes-and-durability","implicit":true,"key":"FgAR7GY0kf"},{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Within one process, a read always sees the latest committed value even if the\ndatabase writer has not caught up: the live form is cached in memory. Making a\nwrite durable — waiting until PostgreSQL has it — is the subject of\n","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"Y8WS6GoTIJ"},{"type":"link","url":"/transactions/commits-and-durability","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Commits and durability","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"fWZodAT1h0"}],"urlSource":"commits-and-durability.md","dataUrl":"/transactions.commits-and-durability.json","internal":true,"protocol":"file","key":"gss2RhxufD"},{"type":"text","value":".","position":{"start":{"l