{"version":3,"kind":"Article","sha256":"477199880b759c620918be41ac6b42df58752156681d0d68db00c1a13874f0d7","slug":"transactions","location":"/transactions.md","dependencies":[],"frontmatter":{"title":"Transactions and volatile forms","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Noah C. Benson","given":"Noah C.","family":"Benson"},"name":"Noah C. Benson","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"MIT","url":"https://opensource.org/licenses/MIT","name":"MIT License","free":true,"osi":true}},"exports":[{"format":"md","filename":"transactions.md","url":"/build/transactions-45d2ee52060a21d4a284f889f373d610.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"b4QAwqnPmi"},{"type":"inlineCode","value":"VolatileForm","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GMZ68Eqw2m"},{"type":"text","value":" is a thin wrapper around an Air ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VCJvkSQb5O"},{"type":"inlineCode","value":"Volatile{Form}","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wknEKaadA4"},{"type":"text","value":". It can be read\nat any time, but it may only be ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R6MgxDPn6L"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"written inside a transaction","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oElAt6qNey"}],"key":"EunZT0ZGIz"},{"type":"text","value":", and when that\ntransaction commits, the new value is sent to the database’s writer.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jW3vUDeHoN"}],"key":"bjD7NOUAyD"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Writing inside a transaction","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"FtKVDQImim"}],"identifier":"writing-inside-a-transaction","label":"Writing inside a transaction","html_id":"writing-inside-a-transaction","implicit":true,"key":"I1jVu4Bp4L"},{"type":"code","lang":"julia","value":"using AirDB, Air\n\nwidget = VolatileForm(db, \"widget\", n = 1)\n\n@tx widget[:n] = 42       # stage the change ...\n# ... it commits here, and the writer is told to save the new form\nvalue(widget[:n])          # 42","position":{"start":{"line":9,"column":1},"end":{"line":17,"column":1}},"key":"FczQqHHe8r"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Outside a transaction a write is an error, inherited from Air:","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Ak7iypPPRP"}],"key":"wYHxWagR9y"},{"type":"code","lang":"julia","value":"widget[:n] = 5\n# ERROR: cannot set volatile outside of transaction","position":{"start":{"line":21,"column":1},"end":{"line":24,"column":1}},"key":"g9D2DydAzI"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"otZCpZYs8p"},{"type":"inlineCode","value":"tx","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"m0CKcxXvzL"},{"type":"text","value":" function is the non-macro form, handy when you already have a closure:","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"YwmMwyQqyz"}],"key":"XssNnXGycY"},{"type":"code","lang":"julia","value":"tx(() -> (widget[:n] = value(widget[:n]) + 1))","position":{"start":{"line":28,"column":1},"end":{"line":30,"column":1}},"key":"VbbEClLPaw"},{"type":"heading","depth":2,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"A commit is atomic","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"SN4pyk32l9"}],"identifier":"a-commit-is-atomic","label":"A commit is atomic","html_id":"a-commit-is-atomic","implicit":true,"key":"OsikxMcWdc"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"All the writes in one transaction become visible together, and all the sends are\ndispatched together, in commit order. A commit that changes several forms writes\nthem to the database in a single database transaction, so a reader never sees\nhalf of a commit.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"C9Mtsuwb9C"}],"key":"YGwYPlp9e7"},{"type":"code","lang":"julia","value":"a = VolatileForm(db, kind = \"A\")\nb = VolatileForm(db, kind = \"B\")\n\n@tx begin\n    a[:v] = 1\n    b[:v] = 2\nend\nAirDB.sync(db)\n(value(a[:v]), value(b[:v]))   # (1, 2) — both landed together","position":{"start":{"line":39,"column":1},"end":{"line":49,"column":1}},"key":"ownJMuQJAd"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"The body may run more than once","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Fn9q50ZOGx"}],"identifier":"the-body-may-run-more-than-once","label":"The body may run more than once","html_id":"the-body-may-run-more-than-once","implicit":true,"key":"WHFNVUx1w9"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Air is optimistic: a transaction records what it reads, and if any of those\nvalues change before it commits, the transaction is discarded and re-run. So the\nbody of a transaction must be free of side effects other than the transactional\nones.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"C2NcXOQha0"}],"key":"fdx3sWo7nB"},{"type":"code","lang":"julia","value":"# Good: the only side effect is the transactional write.\n@tx widget[:n] = value(widget[:n]) + 1\n\n# Bad: this prints a different number of times depending on contention.\n@tx begin\n    println(\"attempt\")          # do not do this\n    widget[:n] = value(widget[:n]) + 1\nend","position":{"start":{"line":58,"column":1},"end":{"line":67,"column":1}},"key":"d1NUUG1DJu"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"If the body throws, nothing is written:","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"NHe8jS5O7t"}],"key":"bG5syCDXFJ"},{"type":"code","lang":"julia","value":"try\n    @tx begin\n        widget[:n] = 99\n        error(\"abort\")\n    end\ncatch\nend\nvalue(widget[:n])                 # still 42 — the write never happened","position":{"start":{"line":71,"column":1},"end":{"line":80,"column":1}},"key":"h3KIiH75cJ"},{"type":"heading","depth":2,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"How a write reaches the database","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"TcSttlYrlJ"}],"identifier":"how-a-write-reaches-the-database","label":"How a write reaches the database","html_id":"how-a-write-reaches-the-database","implicit":true,"key":"Osgr3t1U36"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"AirDB intercepts the write, and — once, per transaction — arranges for the\ncommitted values to reach the writer actor. Air guarantees that a message sent\nduring a transaction is dispatched only if the transaction commits, and in\ncommit order. So the database sees exactly the transactions that succeeded, in\nthe order they committed, and a retried transaction never leaves a trace.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"MjlmzIqN32"}],"key":"F9eXWC0hKc"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"What this means for you","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"yiubtTUKXF"}],"key":"W02tuoD3t5"},{"type":"paragraph","position":{"start":{"line":92,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"You never call the writer directly, and you never write to the database by hand.\nWrite forms inside ","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"NHUZf0mjIl"},{"type":"inlineCode","value":"@tx","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"McN6H8NAJS"},{"type":"text","value":", and AirDB does the rest. Use ","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"tQKXcnMKzG"},{"type":"inlineCode","value":"AirDB.sync(db)","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"POJqH9QEeX"},{"type":"text","value":" only when\nsomething outside the process needs to observe the write.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"EBSOnOky9o"}],"key":"UJCLyTFGOk"}],"class":"tip","key":"G81PcdIwfn"},{"type":"heading","depth":2,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"Reading inside a transaction","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"cWZ38Gyx4p"}],"identifier":"reading-inside-a-transaction","label":"Reading inside a transaction","html_id":"reading-inside-a-transaction","implicit":true,"key":"CeYeMphRK4"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"Reading a form inside a transaction registers an Air read, so the transaction\nsees a consistent value and will be re-run if it changes. A form that has not yet\nbeen loaded from the database is loaded on first access — that is ordinary lazy\nloading (see ","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"JFfNEGUIH7"},{"type":"link","url":"/persistence","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Persistence","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"PKh59ogLAQ"}],"urlSource":"persistence.md","dataUrl":"/persistence.json","internal":true,"protocol":"file","key":"oOudaKcO6s"},{"type":"text","value":"), and it is safe to do inside a\ntransaction.","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"CT5FRjiAtt"}],"key":"AWuH3Yt6Oq"},{"type":"code","lang":"julia","value":"@tx begin\n    current = value(widget[:n])   # read (and register)\n    widget[:n] = current + 1 # write\nend","position":{"start":{"line":105,"column":1},"end":{"line":110,"column":1}},"key":"S4LBQg0Gd2"},{"type":"heading","depth":2,"position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"text","value":"Volatile forms link to one another","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"sP7Yf37jCA"}],"identifier":"volatile-forms-link-to-one-another","label":"Volatile forms link to one another","html_id":"volatile-forms-link-to-one-another","implicit":true,"key":"tbNX74cZ9A"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"Because a form may hold a ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"uG3MMttLtN"},{"type":"inlineCode","value":"VolatileForm","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"hb5hM0kTYz"},{"type":"text","value":", forms compose into a tree of\nindependently-versioned pieces. A transaction that reaches through a child form\nreads it and (if it writes) writes only the part it actually changes; see\n","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"tvnYVQprjX"},{"type":"link","url":"/indexing","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Indexing and updating","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"pSv2CUT2pw"}],"urlSource":"indexing.md","dataUrl":"/indexing.json","internal":true,"protocol":"file","key":"h6P2JLPkku"},{"type":"text","value":" for the details.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"V5YHcyazNf"}],"key":"p79Jpqwoqs"},{"type":"code","lang":"julia","value":"child  = VolatileForm(db, n = 0)\nparent = VolatileForm(db, name = \"parent\", child = child)\n\n@tx parent[:child, :n] = 1     # writes `child`, reads `parent`","position":{"start":{"line":119,"column":1},"end":{"line":124,"column":1}},"key":"Ul7w7czqzf"}],"key":"aezpKTJcka"}],"key":"YUM4IRSqUu"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Forms","url":"/forms","group":"AirDB.jl"},"next":{"title":"Indexing and updating","url":"/indexing","group":"AirDB.jl"}}},"domain":"http://localhost:3000"}