{"version":3,"kind":"Article","sha256":"477199880b759c620918be41ac6b42df58752156681d0d68db00c1a13874f0d7","slug":"transactions","location":"/transactions.md","dependencies":[],"frontmatter":{"title":"Transactions and volatile forms","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Noah C. Benson","given":"Noah C.","family":"Benson"},"name":"Noah C. Benson","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"MIT","url":"https://opensource.org/licenses/MIT","name":"MIT License","free":true,"osi":true}},"exports":[{"format":"md","filename":"transactions.md","url":"/build/transactions-9de6e73d71df885a7cda689c7efffa07.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p5s4c5a1OD"},{"type":"inlineCode","value":"VolatileForm","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"k6mOfQCdCC"},{"type":"text","value":" is a thin wrapper around an Air ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"t9WA4pWYdM"},{"type":"inlineCode","value":"Volatile{Form}","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Qi5zoNkV3J"},{"type":"text","value":". It can be read\nat any time, but it may only be ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZHXrVKSvDM"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"written inside a transaction","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"r9W4SSQOwy"}],"key":"BWFbgIL1ft"},{"type":"text","value":", and when that\ntransaction commits, the new value is sent to the database’s writer.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Egcof7mEtj"}],"key":"kLXrBOQBpM"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Writing inside a transaction","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"kpUwdiWE4Z"}],"identifier":"writing-inside-a-transaction","label":"Writing inside a transaction","html_id":"writing-inside-a-transaction","implicit":true,"key":"zM7DhmzCOl"},{"type":"code","lang":"julia","value":"using AirDB, Air\n\nwidget = VolatileForm(db, \"widget\", n = 1)\n\n@tx widget[:n] = 42       # stage the change ...\n# ... it commits here, and the writer is told to save the new form\nvalue(widget[:n])          # 42","position":{"start":{"line":9,"column":1},"end":{"line":17,"column":1}},"key":"y1Sir9Yrd5"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Outside a transaction a write is an error, inherited from Air:","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"gWwnDKrBWb"}],"key":"ssDKLJUELP"},{"type":"code","lang":"julia","value":"widget[:n] = 5\n# ERROR: cannot set volatile outside of transaction","position":{"start":{"line":21,"column":1},"end":{"line":24,"column":1}},"key":"e3MESzYaHz"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"cpLqYVdB7G"},{"type":"inlineCode","value":"tx","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ikhBuAnr6r"},{"type":"text","value":" function is the non-macro form, handy when you already have a closure:","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"Uj1yLA3Lnb"}],"key":"aYDUvTtDDu"},{"type":"code","lang":"julia","value":"tx(() -> (widget[:n] = value(widget[:n]) + 1))","position":{"start":{"line":28,"column":1},"end":{"line":30,"column":1}},"key":"gqKzEv414u"},{"type":"heading","depth":2,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"A commit is atomic","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"tTWJ3j4C1y"}],"identifier":"a-commit-is-atomic","label":"A commit is atomic","html_id":"a-commit-is-atomic","implicit":true,"key":"l9322EGaof"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"All the writes in one transaction become visible together, and all the sends are\ndispatched together, in commit order. A commit that changes several forms writes\nthem to the database in a single database transaction, so a reader never sees\nhalf of a commit.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"PejlxlO8MN"}],"key":"MqRsx0mSbF"},{"type":"code","lang":"julia","value":"a = VolatileForm(db, kind = \"A\")\nb = VolatileForm(db, kind = \"B\")\n\n@tx begin\n    a[:v] = 1\n    b[:v] = 2\nend\nAirDB.sync(db)\n(value(a[:v]), value(b[:v]))   # (1, 2) — both landed together","position":{"start":{"line":39,"column":1},"end":{"line":49,"column":1}},"key":"c4N4Nbhtlj"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"The body may run more than once","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"iI8Q6lYy3w"}],"identifier":"the-body-may-run-more-than-once","label":"The body may run more than once","html_id":"the-body-may-run-more-than-once","implicit":true,"key":"nh5F5jfxvh"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Air is optimistic: a transaction records what it reads, and if any of those\nvalues change before it commits, the transaction is discarded and re-run. So the\nbody of a transaction must be free of side effects other than the transactional\nones.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"wULyNRYguv"}],"key":"b8BWP2eAN0"},{"type":"code","lang":"julia","value":"# Good: the only side effect is the transactional write.\n@tx widget[:n] = value(widget[:n]) + 1\n\n# Bad: this prints a different number of times depending on contention.\n@tx begin\n    println(\"attempt\")          # do not do this\n    widget[:n] = value(widget[:n]) + 1\nend","position":{"start":{"line":58,"column":1},"end":{"line":67,"column":1}},"key":"I82ncTjh8j"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"If the body throws, nothing is written:","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"sLutfPEEKr"}],"key":"c80fAseAPQ"},{"type":"code","lang":"julia","value":"try\n    @tx begin\n        widget[:n] = 99\n        error(\"abort\")\n    end\ncatch\nend\nvalue(widget[:n])                 # still 42 — the write never happened","position":{"start":{"line":71,"column":1},"end":{"line":80,"column":1}},"key":"DzPV53uqIW"},{"type":"heading","depth":2,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"How a write reaches the database","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"RJh1IOYgWV"}],"identifier":"how-a-write-reaches-the-database","label":"How a write reaches the database","html_id":"how-a-write-reaches-the-database","implicit":true,"key":"oxIPrVt0Kr"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"AirDB intercepts the write, and — once, per transaction — arranges for the\ncommitted values to reach the writer actor. Air guarantees that a message sent\nduring a transaction is dispatched only if the transaction commits, and in\ncommit order. So the database sees exactly the transactions that succeeded, in\nthe order they committed, and a retried transaction never leaves a trace.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"CTD0460eB1"}],"key":"e1wbyoA0MY"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"What this means for you","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"MXJTSnXgn1"}],"key":"hcWQUSetWU"},{"type":"paragraph","position":{"start":{"line":92,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"You never call the writer directly, and you never write to the database by hand.\nWrite forms inside ","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"AlyZh0sUak"},{"type":"inlineCode","value":"@tx","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"rd03B39MYH"},{"type":"text","value":", and AirDB does the rest. Use ","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"ZPzbHN9YxI"},{"type":"inlineCode","value":"AirDB.sync(db)","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"FZWRmGfbrw"},{"type":"text","value":" only when\nsomething outside the process needs to observe the write.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"FNuGPvA6Jy"}],"key":"DOSoDxrnZw"}],"class":"tip","key":"L3nElNDxsg"},{"type":"heading","depth":2,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"Reading inside a transaction","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"j39hfY2s3E"}],"identifier":"reading-inside-a-transaction","label":"Reading inside a transaction","html_id":"reading-inside-a-transaction","implicit":true,"key":"m3X4mj2V4o"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"Reading a form inside a transaction registers an Air read, so the transaction\nsees a consistent value and will be re-run if it changes. A form that has not yet\nbeen loaded from the database is loaded on first access — that is ordinary lazy\nloading (see ","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"wbzNeJaLf9"},{"type":"link","url":"/persistence","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Persistence","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"JNuFpnbI4Y"}],"urlSource":"persistence.md","dataUrl":"/persistence.json","internal":true,"protocol":"file","key":"zawDyBlaGD"},{"type":"text","value":"), and it is safe to do inside a\ntransaction.","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"TxEXGzPYye"}],"key":"OYDp3bhOOo"},{"type":"code","lang":"julia","value":"@tx begin\n    current = value(widget[:n])   # read (and register)\n    widget[:n] = current + 1 # write\nend","position":{"start":{"line":105,"column":1},"end":{"line":110,"column":1}},"key":"xLilMwdCp7"},{"type":"heading","depth":2,"position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"text","value":"Volatile forms link to one another","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"sSFcKDqa7q"}],"identifier":"volatile-forms-link-to-one-another","label":"Volatile forms link to one another","html_id":"volatile-forms-link-to-one-another","implicit":true,"key":"hs2tpT5Gi1"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"Because a form may hold a ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"xdI81LVmHL"},{"type":"inlineCode","value":"VolatileForm","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"HbKPvtBeL2"},{"type":"text","value":", forms compose into a tree of\nindependently-versioned pieces. A transaction that reaches through a child form\nreads it and (if it writes) writes only the part it actually changes; see\n","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"OMeZW8kSfI"},{"type":"link","url":"/indexing","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Indexing and updating","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"OvcRY2g2rv"}],"urlSource":"indexing.md","dataUrl":"/indexing.json","internal":true,"protocol":"file","key":"eJara9XLvN"},{"type":"text","value":" for the details.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"j1m16z6yH2"}],"key":"diWUDBIBkj"},{"type":"code","lang":"julia","value":"child  = VolatileForm(db, n = 0)\nparent = VolatileForm(db, name = \"parent\", child = child)\n\n@tx parent[:child, :n] = 1     # writes `child`, reads `parent`","position":{"start":{"line":119,"column":1},"end":{"line":124,"column":1}},"key":"cD81b6TEdd"}],"key":"EspfmUOP2K"}],"key":"m3IunE66j9"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Extern types","url":"/externs","group":"AirDB.jl"},"next":{"title":"Indexing and updating","url":"/indexing","group":"AirDB.jl"}}},"domain":"http://localhost:3000"}